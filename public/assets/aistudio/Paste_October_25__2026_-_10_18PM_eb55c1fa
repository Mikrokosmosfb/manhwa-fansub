// ==========================================
// RASTGELE TUZLAMALI (SALT) & UTF-8 UYUMLU ŞİFRELEME FONKSİYONLARI
// ==========================================
function obfuscate(str, key) {
  const encodedStr = encodeURIComponent(str);
  const salt = Math.floor(Math.random() * 256);
  let result = salt.toString(16).padStart(2, '0');
  for (let i = 0; i < encodedStr.length; i++) {
    const charCode = encodedStr.charCodeAt(i) ^ key.charCodeAt(i % key.length) ^ salt;
    result += charCode.toString(16).padStart(2, '0');
  }
  return result;
}

function deobfuscate(hex, key) {
  try {
    if (!hex || hex.length < 2) return null;
    
    const salt = parseInt(hex.substring(0, 2), 16);
    if (isNaN(salt)) return null;
    
    let result = "";
    let keyIndex = 0;
    for (let i = 2; i < hex.length; i += 2) {
      const charCode = parseInt(hex.substr(i, 2), 16) ^ key.charCodeAt(keyIndex % key.length) ^ salt;
      if (isNaN(charCode)) return null;
      result += String.fromCharCode(charCode);
      keyIndex++;
    }
    return decodeURIComponent(result);
  } catch (e) {
    return null;
  }
}

