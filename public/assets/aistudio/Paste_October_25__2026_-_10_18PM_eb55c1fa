    function removeFolderFromQueue(chapterName) {
      const stats = chapterStats[chapterName];
      if (!stats) return;

      if (stats.status === 'uploading') {
        if (!confirm('Şu an yüklenmekte olan "' + chapterName + '" klasörünü durdurmak istediğinize emin misiniz?')) return;
        chapterStats[chapterName].status = 'error';
      }

      bulkUploadFilesList = bulkUploadFilesList.filter(item => {
        const parts = item.path.split('/');
        return parts[parts.length - 2] !== chapterName;
      });

      if (stats.status !== 'uploading') {
        delete chapterStats[chapterName];
      }

      const previewText = document.getElementById('dropzonePreviewText');
      const foldersCount = Object.keys(chapterStats).length;
      if (foldersCount > 0) {
        previewText.innerHTML = '<span class="text-indigo-400 font-semibold">' + foldersCount + ' Klasör</span> içinde toplam <span class="text-indigo-400 font-semibold">' + bulkUploadFilesList.length + ' görsel</span> algılandı.';
      } else {
        previewText.innerText = "Yüklenecek klasör yapısı korunacaktır";
        document.getElementById('uploadStatusList').classList.add('hidden');
      }

      showToast('"' + chapterName + '" listeden çıkarıldı.', 'success');
      renderStatusList();
    }

