      statusDiv.innerHTML = '<h3 class="text-xs font-semibold text-slate-400 mb-2 border-b border-slate-700 pb-1.5 flex items-center space-x-1">📂 <span>Klasör Yükleme Durumları</span></h3>';
      
      chapters.forEach(chapter => {
