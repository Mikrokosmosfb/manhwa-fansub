    function buildTree(objects) {
      structuredTree = {};
      objects.forEach(obj => {
        const parts = obj.key.split('/');
        if (parts.length >= 3) {
          const series = parts[0];
          const chapter = parts[1];
          const filename = parts.slice(2).join('/');
          
          if (!structuredTree[series]) structuredTree[series] = {};
          if (!structuredTree[series][chapter]) structuredTree[series][chapter] = [];
          structuredTree[series][chapter].push({ key: obj.key, name: filename, size: obj.size });
        } else {
          const series = "Genel Dosyalar";
          const chapter = "Genel";
          if (!structuredTree[series]) structuredTree[series] = {};
          if (!structuredTree[series][chapter]) structuredTree[series][chapter] = [];
          structuredTree[series][chapter].push({ key: obj.key, name: obj.key, size: obj.size });
        }
      });

      for (let s in structuredTree) {
        for (let c in structuredTree[s]) {
          structuredTree[s][c].sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }));
        }
      }
    }

