        } else if (stats.status === 'success') {
          statusText = '✅ Yüklendi';
          colorClass = 'text-emerald-400 font-semibold';
        } else if (stats.status === 'error') {
          statusText = '❌ Yüklenemedi';
          colorClass = 'text-red-400 font-semibold';
        } else if (stats.status === 'pending') {
          cancelBtn = '<button onclick="removeFolderFromQueue(\\'' + chapter.replace(/'/g, "\\\\'") + '\\')" class="text-slate-500 hover:text-red-400 ml-2 font-bold cursor-pointer" title="Sıradan Çıkar">✕</button>';
