    async function getFilesFromEntry(entry, path = "") {
      if (entry.isFile) {
        return new Promise((resolve) => {
          entry.file(
            (file) => resolve([{ file, path: path + file.name }]),
            () => resolve([]) 
          );
        });
      } else if (entry.isDirectory) {
        const dirReader = entry.createReader();
        const readBatch = () => {
          return new Promise((resolve) => {
            dirReader.readEntries((results) => resolve(results), () => resolve([]));
          });
        };

        let allEntries = [];
        while (true) {
          const batch = await readBatch();
          if (!batch || batch.length === 0) break;
          allEntries.push(...batch);
        }

        const files = [];
        for (const childEntry of allEntries) {
          const childFiles = await getFilesFromEntry(childEntry, path + entry.name + "/");
          files.push(...childFiles);
        }
        return files;
      }
      return [];
    }

    async function handleFolderDrop(e) {
      e.preventDefault();
      const items = Array.from(e.dataTransfer.items);
      bulkUploadFilesList = [];
      
      showToast('Klasörler taranıyor, lütfen bekleyin...', 'success');
      
      const fileEntryPromises = items.map(async (item) => {
        if (item.kind === 'file') {
          const entry = item.webkitGetAsEntry();
          if (entry) return await getFilesFromEntry(entry);
        }
        return [];
      });
      
      const results = await Promise.all(fileEntryPromises);
      results.forEach(files => { bulkUploadFilesList.push(...files); });
      renderFolderUploadPreview();
    }

    function handleFolderSelect(input) {
      const files = Array.from(input.files);
      bulkUploadFilesList = files.map(file => ({
        file: file,
        path: file.webkitRelativePath
      }));
      renderFolderUploadPreview();
    }

    function renderFolderUploadPreview() {
      const previewText = document.getElementById('dropzonePreviewText');
      const statusListDiv = document.getElementById('uploadStatusList');
      
      if (bulkUploadFilesList.length > 0) {
        chapterStats = {};
        const folders = new Set();
        
        bulkUploadFilesList.forEach(item => {
          const parts = item.path.split('/');
          if (parts.length >= 2) {
            const chapter = parts[parts.length - 2]; 
            folders.add(chapter);
            
            if (!chapterStats[chapter]) {
              chapterStats[chapter] = { total: 0, uploaded: 0, status: 'pending' };
            }
            chapterStats[chapter].total++;
          }
        });
        
        previewText.innerHTML = '<span class="text-indigo-400 font-semibold">' + folders.size + ' Klasör</span> içinde toplam <span class="text-indigo-400 font-semibold">' + bulkUploadFilesList.length + ' görsel</span> algılandı.';
        statusListDiv.classList.remove('hidden');
        renderStatusList();
        showToast('Toplam ' + folders.size + ' bölüm klasörü hazırlandı.', 'success');
      } else {
        previewText.innerText = "Yüklenecek klasör yapısı korunacaktır";
        statusListDiv.classList.add('hidden');
      }
    }

