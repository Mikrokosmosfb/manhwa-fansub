// ==========================================
// WORKER CORE LOGIC
// ==========================================
export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;

    // 1. ADMIN PANEL - WEB ARAYÜZÜ
    if (path === "/admin") {
      return new Response(ADMIN_HTML, {
        headers: { "Content-Type": "text/html; charset=utf-8" }
      });
    }

    // 2. DOSYA YÜKLEME API
    if (path === "/api/upload" && request.method === "POST") {
      try {
        const formData = await request.formData();
        const folder = formData.get("folder").replace(/^\/+|\/+$/g, ''); 
        const file = formData.get("file");

        if (!folder || !file) {
          return new Response(JSON.stringify({ error: "Missing folder or file" }), { status: 400 });
        }

        const fullPath = `${folder}/${file.name}`;
        
        await env.MY_BUCKET.put(fullPath, file.stream(), {
          httpMetadata: { contentType: file.type }
        });

        return new Response(JSON.stringify({ success: true, path: fullPath }), {
          headers: { "Content-Type": "application/json" }
        });
      } catch (err) {
        return new Response(JSON.stringify({ error: err.message }), { status: 500 });
      }
    }

    // 3. DOSYALARI LİSTELEME API
    if (path === "/api/list" && request.method === "GET") {
      try {
        let allObjects = [];
        let cursor = undefined;
        
        while (true) {
          const list = await env.MY_BUCKET.list({ limit: 1000, cursor: cursor });
          if (list.objects && list.objects.length > 0) {
            allObjects.push(...list.objects);
          }
          if (!list.truncated || !list.cursor) {
            break;
          }
          cursor = list.cursor;
        }
        
        return new Response(JSON.stringify(allObjects), {
          headers: { "Content-Type": "application/json" }
        });
      } catch (err) {
        return new Response(JSON.stringify({ error: err.message }), { status: 500 });
      }
    }

    // 4. DOSYA SİLME API
    if (path === "/api/delete" && request.method === "POST") {
      try {
        const { key } = await request.json();
        if (!key) return new Response("Missing key", { status: 400 });

        await env.MY_BUCKET.delete(key);
        return new Response(JSON.stringify({ success: true }), {
          headers: { "Content-Type": "application/json" }
        });
      } catch (err) {
        return new Response(JSON.stringify({ error: err.message }), { status: 500 });
      }
    }

    // 5. ROBOTS.TXT
    if (path === "/robots.txt") {
      return new Response("User-agent: *\nDisallow: /", {
        headers: { "Content-Type": "text/plain" }
      });
    }

    // 6. ŞİFRELİ GÖRSEL ÇÖZÜCÜ VE SERVİS EDİCİ (GÜVENLİ VE CORS DESTEKLİ)
    if (path.startsWith("/img/")) {
      const referer = request.headers.get("referer");
      const isSelf = referer && (referer.includes("/admin") || referer.includes("localhost"));

      let isAllowed = false;

      if (isSelf) {
        isAllowed = true;
      } else if (referer) {
        try {
          const refererUrl = new URL(referer);
          // İzin verilen alan adı kontrolü
          if (ALLOWED_REFERERS.some(allowedDomain => refererUrl.hostname.includes(allowedDomain))) {
            isAllowed = true;
          }
        } catch (e) {}
      } else {
        // Referer bilgisi göndermeyen gizlilik tarayıcılarına (Brave, iOS Safari Gizli Mod, AdBlock vb.) izin veriyoruz
        isAllowed = true;
      }

      // Hırsız başka bir siteden çağırıyorsa troll resmi ver
      if (!isAllowed) {
        return Response.redirect(TROLL_IMAGE_URL, 302);
      }

      // Şifreli Hex kodunu alıp deşifre ediyoruz
      const encryptedHex = path.slice(5); 
      const realObjectKey = deobfuscate(encryptedHex, ENCRYPTION_KEY);

      if (!realObjectKey) {
        return new Response("Geçersiz bağlantı formatı.", { status: 400 });
      }

      const object = await env.MY_BUCKET.get(realObjectKey);
      if (!object) {
        return new Response("Resim bulunamadı.", { status: 404 });
      }

      const headers = new Headers();
      object.writeHttpMetadata(headers);
      headers.set("etag", object.httpEtag);
      headers.set("X-Robots-Tag", "noindex, nofollow, noimageindex");
      headers.set("Cache-Control", "public, max-age=31536000, immutable"); 
      
      // CORS Başlığı: Temaların ve Lazy Load eklentilerinin görselleri okuyabilmesi için zorunludur
      headers.set("Access-Control-Allow-Origin", "*");

      return new Response(object.body, { headers });
    }

    return new Response("Bulunamadı.", { status: 404 });
  }
};