    async function uploadFiles() {
      const uploadMode = document.querySelector('input[name="uploadMode"]:checked').value;
      const mode = document.querySelector('input[name="seriesMode"]:checked').value;
      let seriesName = (mode === 'existing') ? document.getElementById('seriesSearchInput').value.trim() : document.getElementById('newSeriesInput').value.trim();

      if (!seriesName) {
        showToast('Lütfen bir Seri ismi seçin veya oluşturun.', 'error');
        return;
      }

      const uploadBtn = document.getElementById('uploadBtn');
      const progressContainer = document.getElementById('progressContainer');
      const progressBar = document.getElementById('progressBar');
      const progressPercent = document.getElementById('progressPercent');

      if (uploadMode === 'single') {
        const chapterName = document.getElementById('chapterInput').value.trim().replace(/^\\/+|\\/+$/g, '');
        const fileInput = document.getElementById('fileInput');

        if (!chapterName) {
          showToast('Lütfen bir Bölüm ismi girin.', 'error');
          return;
        }
        if (fileInput.files.length === 0) {
          showToast('Lütfen yüklenecek görselleri seçin.', 'error');
          return;
        }

        uploadBtn.disabled = true;
        progressContainer.classList.remove('hidden');

        const files = Array.from(fileInput.files);
        const total = files.length; 
        let completed = 0;
        const folderPath = seriesName + '/' + chapterName;

        for (const file of files) {
          const formData = new FormData();
          formData.append('folder', folderPath);
          formData.append('file', file);

          try {
            const res = await fetch('/api/upload', { method: 'POST', body: formData });
            if (res.ok) {
              completed++;
              const pct = Math.round((completed / total) * 100);
              progressBar.style.width = pct + '%';
              progressPercent.innerText = pct + '%';
            }
          } catch (err) {
            console.error(err);
          }
        }
      } else {
        if (bulkUploadFilesList.length === 0) {
          showToast('Lütfen önce sürükleyerek veya seçerek klasör ekleyin.', 'error');
          return;
        }

        isUploadCancelled = false; 
        uploadBtn.disabled = true;
        progressContainer.classList.remove('hidden');
        document.getElementById('uploadStatusList').classList.remove('hidden');

        const total = bulkUploadFilesList.length;
        let completed = 0;
        const batchSize = 3;

        for (let i = 0; i < total; i += batchSize) {
          if (isUploadCancelled) {
            showToast('Yükleme işlemi durduruldu.', 'error');
            break;
          }

          const batch = bulkUploadFilesList.slice(i, i + batchSize);
          await Promise.all(batch.map(async (item) => {
            if (isUploadCancelled) return;

            const parts = item.path.split('/');
            if (parts.length < 2) return; 

            const chapter = parts[parts.length - 2];
            if (!chapterStats[chapter] || chapterStats[chapter].status === 'error') return;

            const folderPath = seriesName + '/' + chapter;

            if (chapterStats[chapter].status === 'pending') {
              chapterStats[chapter].status = 'uploading';
              renderStatusList();
            }

            const formData = new FormData();
            formData.append('folder', folderPath);
            formData.append('file', item.file);

            try {
              const res = await fetch('/api/upload', { method: 'POST', body: formData });
              if (res.ok) {
                completed++;
                chapterStats[chapter].uploaded++;
                if (chapterStats[chapter].uploaded === chapterStats[chapter].total) {
                  chapterStats[chapter].status = 'success';
                }
                renderStatusList();
                
                const pct = Math.round((completed / total) * 100);
                progressBar.style.width = pct + '%';
                progressPercent.innerText = pct + '%';
              } else {
                chapterStats[chapter].status = 'error';
                renderStatusList();
              }
            } catch (err) {
              console.error(err);
              chapterStats[chapter].status = 'error';
              renderStatusList();
            }
          }));
        }
        
        bulkUploadFilesList = [];
        document.getElementById('dropzonePreviewText').innerText = "Yüklenecek klasör yapısı korunacaktır";
      }

      showToast(isUploadCancelled ? 'Yükleme durduruldu.' : 'Yükleme işlemi tamamlandı.');
      document.getElementById('fileInput').value = '';
      uploadBtn.disabled = false;
      progressContainer.classList.add('hidden');
      progressBar.style.width = '0%';
      progressPercent.innerText = '0%';
      document.getElementById('newSeriesInput').value = '';
      document.getElementById('chapterInput').value = '';
      loadFiles();
    }

    function generateEmbed(seriesName, chapterName) {
      const files = structuredTree[seriesName][chapterName] || [];
      const currentHost = window.location.origin;

      let embedHtml = '<div class="wt-cont">\\n';
      files.forEach(file => {
        const encryptedKey = obfuscate(file.key, SERVER_ENCRYPTION_KEY);
        embedHtml += '  <img src="' + currentHost + '/img/' + encryptedKey + '" class="wt-img" alt="Görsel yüklenemedi." />\\n';
      });
      embedHtml += '</div>';

      document.getElementById('modalTitle').innerText = seriesName + ' / ' + chapterName + ' - Embed Kodu';
      document.getElementById('embedCodeText').value = embedHtml;
      document.getElementById('embedModal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('embedModal').classList.add('hidden');
    }

    function copyEmbedCode() {
      const textarea = document.getElementById('embedCodeText');
      textarea.select();
      document.execCommand('copy');
      showToast('Embed kodu panoya kopyalandı.');
    }

    async function deleteSingleFile(key) {
      if (!confirm('Bu görseli kalıcı olarak silmek istediğinize emin misiniz?')) return;
      try {
        const res = await fetch('/api/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: key })
        });
        if (res.ok) {
          showToast('Dosya silindi.');
          loadFiles();
        } else {
          showToast('Silme başarısız.', 'error');
        }
      } catch (err) {
        showToast('Hata: ' + err.message, 'error');
      }
    }

    async function deleteChapterFromList(seriesName, chapterName) {
      if (!confirm(chapterName + ' bölümündeki tüm resimleri silmek istediğinize emin misiniz?')) return;
      const files = structuredTree[seriesName][chapterName] || [];
      for (const file of files) {
        await fetch('/api/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: file.key })
        });
      }
      showToast('Bölüm silindi.');
      loadFiles();
    }

    async function deleteEntireSeries(seriesName) {
      if (!confirm(seriesName + ' serisini ve TÜM BÖLÜMLERİNİ silmek istediğinize emin misiniz?')) return;
      const chapters = structuredTree[seriesName] || {};
      for (let chapterName in chapters) {
        const files = chapters[chapterName] || [];
        for (const file of files) {
          await fetch('/api/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ key: file.key })
          });
        }
      }
      showToast(seriesName + ' serisi tamamen silindi.');
      loadFiles();
    }

    async function deleteChapter(seriesName, chapterName) {
      if (!confirm(chapterName + ' bölümündeki tüm resimleri silmek istediğinize emin misiniz?')) return;
      const files = structuredTree[seriesName][chapterName] || [];
      for (const file of files) {
        await fetch('/api/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: file.key })
        });
      }
      showToast('Bölüm silindi.');
      currentPath.pop();
      loadFiles();
    }

    loadFiles();
  </script>
