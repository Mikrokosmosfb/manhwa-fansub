        let colorClass = 'text-slate-400';
        let cancelBtn = '';
        
        if (stats.status === 'uploading') {
          statusText = '🔄 Yükleniyor (' + stats.uploaded + '/' + stats.total + ')';
          colorClass = 'text-indigo-400 font-medium animate-pulse';
