    async function downloadBackupZIP() {
      if (rawFilesList.length === 0) {
        showToast('Kütüphanede yedeklenecek dosya bulunamadı.', 'error');
        return;
      }
      
      if (!confirm('Tüm kütüphaneniz ZIP olarak indirilecektir. Onaylıyor musunuz?')) return;
      showToast('Yedek hazırlanıyor, lütfen bekleyin...', 'success');
      
      const zip = new JSZip();
      let downloaded = 0;
      const total = rawFilesList.length;
      const batchSize = 5;

      for (let i = 0; i < total; i += batchSize) {
        const batch = rawFilesList.slice(i, i + batchSize);
        await Promise.all(batch.map(async (file) => {
          try {
            const encryptedPath = obfuscate(file.key, SERVER_ENCRYPTION_KEY);
            const response = await fetch(window.location.origin + '/img/' + encryptedPath);
            if (response.ok) {
              const blob = await response.blob();
              zip.file(file.key, blob); 
              downloaded++;
            }
          } catch (e) {
            console.error('Yedekleme hatası:', e);
          }
        }));
        showToast("Yedek: " + downloaded + "/" + total + " görsel paketlendi...", "success");
      }
      
      try {
        const content = await zip.generateAsync({ type: 'blob' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(content);
        link.download = 'manhva-depo-yedek-' + new Date().toISOString().slice(0,10) + '.zip';
        link.click();
        showToast('Tüm kütüphane başarıyla yedeklendi!', 'success');
      } catch (err) {
        showToast('ZIP hatası: ' + err.message, 'error');
      }
    }

    async function restoreBackupZIP() {
      const zipInput = document.getElementById('zipRestoreInput');
      if (zipInput.files.length === 0) {
        showToast('Lütfen önce geçerli bir ZIP yedek dosyası seçin.', 'error');
        return;
      }
      
      if (!confirm('ZIP içindeki dosyalar R2 deponuza yüklenecektir. Başlatılsın mı?')) return;
      const file = zipInput.files[0];
      
      try {
        const zip = await JSZip.loadAsync(file);
        const filesToUpload = [];
        zip.forEach((relativePath, zipEntry) => {
          if (!zipEntry.dir) filesToUpload.push(zipEntry);
        });
        
        const total = filesToUpload.length;
        if (total === 0) {
          showToast('ZIP içinde dosya bulunamadı.', 'error');
          return;
        }
        
        const uploadBtn = document.getElementById('uploadBtn');
        const progressContainer = document.getElementById('progressContainer');
        const progressBar = document.getElementById('progressBar');
        const progressPercent = document.getElementById('progressPercent');
        
        uploadBtn.disabled = true;
        progressContainer.classList.remove('hidden');
        
        let completed = 0;
        const batchSize = 3;
        for (let i = 0; i < total; i += batchSize) {
          const batch = filesToUpload.slice(i, i + batchSize);
          await Promise.all(batch.map(async (zipEntry) => {
            try {
              const blob = await zipEntry.async('blob');
              const fullPath = zipEntry.name;
              const lastSlash = fullPath.lastIndexOf('/');
              if (lastSlash === -1) return; 
              
              const folder = fullPath.substring(0, lastSlash);
              const filename = fullPath.substring(lastSlash + 1);
              const fileToUpload = new File([blob], filename, { type: blob.type || 'image/jpeg' });
              
              const formData = new FormData();
              formData.append('folder', folder);
              formData.append('file', fileToUpload);
              
              const res = await fetch('/api/upload', { method: 'POST', body: formData });
              if (res.ok) {
                completed++;
                const pct = Math.round((completed / total) * 100);
                progressBar.style.width = pct + '%';
                progressPercent.innerText = pct + '%';
              }
            } catch (err) {
              console.error('Yedek yükleme hatası:', err);
            }
          }));
        }
        
        showToast('Yedekten geri yükleme tamamlandı!', 'success');
        zipInput.value = '';
        uploadBtn.disabled = false;
        progressContainer.classList.add('hidden');
        loadFiles();
      } catch (err) {
        showToast('Hata: ' + err.message, 'error');
      }
    }

